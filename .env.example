# ── PostgreSQL container ──────────────────────────────────────
# These are read by docker-compose to initialise the database.
POSTGRES_DB=fitops
POSTGRES_USER=fitops
POSTGRES_PASSWORD=your_postgres_password

# ── pgAdmin ───────────────────────────────────────────────────
# Login credentials for the pgAdmin web UI at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_postgres_password

# ── Spring Boot application ───────────────────────────────────
# These are read by application.properties to connect to the DB.
# DB_USERNAME must equal POSTGRES_USER.
# DB_PASSWORD must equal POSTGRES_PASSWORD.
DB_URL=jdbc:postgresql://localhost:5432/fitops
DB_USERNAME=fitops
DB_PASSWORD=your_postgres_password

# ── JWT ───────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-32-plus-byte-secret

# Comma-separated allowed origins for browser CORS (web client)
FITOPS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Refresh Token ───────────────────────────────────
REFRESH_TOKEN_TTL=time-to-live
REFRESH_COOKIE_NAME=name-of-refresh-cookie
REFRESH_COOKIE_PATH=path-of-refresh-cookie
REFRESH_COOKIE_SECURE=true-or-false #production must be true; local dev can stay false due to reliably in Postman